# FinovaLabs Environment Configuration
# Copy this file to ".env" in the project root and fill in your values.
# Note: ".env" is listed in .gitignore and will NOT be committed to Git.

# SEC EDGAR Fair Access policy requires a descriptive User-Agent with a valid email.
FINOVALABS_SEC_CONTACT_EMAIL=your.name@yourdomain.com

# PostgreSQL Connection URI (Supabase, Neon, Vercel Postgres, or AWS RDS)
# For Supabase serverless, use Supavisor transaction pooler on port 6543:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Authentication Toggle (false for public open access, true to require X-API-Key / Bearer token)
FINOVALABS_REQUIRE_AUTH=false

# Optional API Tokens (only used when FINOVALABS_REQUIRE_AUTH=true)
# FINOVALABS_ADMIN_TOKEN=fl-admin-secret-key
# FINOVALABS_ANALYST_TOKEN=fl-analyst-secret-key
