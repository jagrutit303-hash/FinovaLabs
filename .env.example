# Copy this file to ".env" in the project root and set your real contact email.
# SEC EDGAR Fair Access policy requires a descriptive User-Agent with a valid email.
# Note: ".env" is listed in .gitignore and will NOT be committed to Git.

FINOVALABS_SEC_CONTACT_EMAIL=your.name@yourdomain.com

# Optional: override the full User-Agent string directly instead of using the email above
# FINOVALABS_SEC_USER_AGENT="FinovaLabs your.name@yourdomain.com"

